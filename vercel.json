{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scraper",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/snapshot",
      "schedule": "59 23 * * *"
    }
  ]
}
